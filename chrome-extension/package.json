{
  "name": "api-mapper-chrome-extension",
  "version": "0.1.0",
  "description": "Chrome Extension MVP for API Mapper Tool",
  "private": true,
  "scripts": {
    "prebuild": "node scripts/generate-icons.js",
    "build": "webpack --config webpack.config.ts",
    "watch": "webpack --config webpack.config.ts --watch",
    "build:prod": "node scripts/generate-icons.js && webpack --config webpack.config.ts",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/har-format": "^1.2.16",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "copy-webpack-plugin": "^12.0.0",
    "eslint": "^8.57.0",
    "ts-loader": "^9.5.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4"
  }
}
